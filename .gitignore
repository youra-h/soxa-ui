node_modules/
tools/bench-collections/.cache/
tools/bench-collections/results/
tools/bench-collections/*.html
tools/bench-collections/angular/before.ts
tools/bench-collections/angular/after.ts
dist/
dist-ssr/
dist-prof/
dist-count/
dist-size/
lib/
coverage/
*.tsbuildinfo
.DS_Store
*.log
.codex/config.toml
packages/_plugins/

# Сниппеты «открыть в VS Code»: пишутся dev-сервером по запросу из браузера
packages/playground/*/scratch/

# Следы прогона vitest: вложения к отчёту, скриншоты упавших браузерных тестов
# (attachments/failure-screenshots) и отчёты — всё это он пишет сам, в .vitest/
# в корне своего проекта (у браузерного прогона стенда — packages/playground/vue).
# __screenshots__ не игнорируется намеренно: сам прогон туда ничего не пишет, а
# эталоны toMatchScreenshot, которые там лягут, коммитятся.
.vitest/

# Отчёт Playwright о последнем прогоне — пишется при каждом запуске.
test-results/

# Черновик svelte-package: сборка адаптера Svelte собирает выход здесь, копирует
# в dist и за собой не убирает. Перенести каталог можно только конфигом Svelte,
# а его у пакета нет намеренно (AGENTS.md, «Сборка пакетов»).
.svelte-kit/

# Копия манифеста и lock корня: `node tools/min-peers/cli.ts pin` сохраняет её
# до подмены, `restore` возвращает из неё оба файла и убирает каталог
# (docs/agents/build.md, «Версии пакетов»).
.min-peers/

# Size entries of the comparison stand: `tools/bench-compare/size.mjs` writes
# them before every size build.
tools/bench-compare/size/

# SvelteKit consumer source is not a library build output.
!docs/ai/*/examples/sveltekit/src/lib/
!docs/ai/*/examples/sveltekit/src/lib/**

# Local diagnostic output; comparison screenshots and CSS evidence remain tracked.
reports/theme-geometry/**/build.log

# Verbatim stylesheet evidence is committed as lossless gzip archives.
reports/theme-geometry/**/theme.css
