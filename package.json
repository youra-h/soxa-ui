{
  "name": "soxa",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/ui/*",
    "packages/themes/*",
    "packages/icons/*",
    "packages/playground/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24 || >=26"
  },
  "scripts": {
    "agent": "node tools/agent-flow/cli.mjs",
    "agent:setup": "node tools/agent-flow/setup.mjs",
    "test:agent-flow": "node --test tools/agent-flow/__tests__/*.test.mjs",
    "test:bench-validation": "node --test tools/bench-validation/__tests__/*.test.mjs",
    "test:bench-ai": "node --test tools/bench-ai/__tests__/*.test.mjs",
    "bench:validate": "node tools/bench-validation/run.mjs",
    "build": "npm run build --workspace=@soxa-ui/core && npm run build --workspace=@soxa-ui/plugins && npm run build --workspace=@soxa-ui/setup && npm run build --workspace=@soxa-ui/icons-material && npm run build --workspace=@soxa-ui/icons-lucide && npm run build --workspace=@soxa-ui/theme-base && npm run build --workspace=@soxa-ui/theme-oren && npm run build --workspace=@soxa-ui/vue && npm run build --workspace=@soxa-ui/react && npm run build --workspace=@soxa-ui/solid && npm run build --workspace=@soxa-ui/webc && npm run build --workspace=@soxa-ui/svelte && npm run build --workspace=@soxa-ui/angular",
    "watch:theme": "npm run watch --workspace=@soxa-ui/theme-oren",
    "dev": "concurrently -k -n theme,playground -c blue,green \"npm run watch:theme\" \"npm run dev --workspace=@soxa-ui/playground-vue\"",
    "test:setup": "npm run test --workspace=@soxa-ui/setup",
    "test:core": "npm run test --workspace=@soxa-ui/core",
    "test:theme": "npm run test --workspace=@soxa-ui/theme-base && npm run test --workspace=@soxa-ui/theme-oren",
    "test:plugins": "npm run test --workspace=@soxa-ui/plugins",
    "test:vue": "npm run test --workspace=@soxa-ui/vue",
    "test:react": "npm run test --workspace=@soxa-ui/react",
    "test:angular": "npm run test --workspace=@soxa-ui/angular",
    "test:svelte": "npm run test --workspace=@soxa-ui/svelte",
    "test:solid": "npm run test --workspace=@soxa-ui/solid",
    "test:eslint": "vitest run --root tools/eslint",
    "test:min-peers": "vitest run --root tools/min-peers",
    "test:release-notes": "vitest run --root tools/release-notes",
    "test:side-effects": "vitest run --root tools/side-effects",
    "test:install-smoke": "vitest run --root tools/install-smoke",
    "check:published-imports": "vitest run --root tools/published-imports",
    "check:client-directive": "vitest run --root tools/client-directive",
    "check:install": "node tools/install-smoke/cli.ts",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "changeset:version": "node tools/release-plan/cli.mjs prepare",
    "test:webc": "npm run test --workspace=@soxa-ui/webc",
    "test:playground": "npm run test --workspace=@soxa-ui/playground-shared && npm run test --workspace=@soxa-ui/playground-vue",
    "test:layout": "npm run build:css --workspace=@soxa-ui/theme-oren && npm run test:browser --workspace=@soxa-ui/playground-vue",
    "test:layout:webkit": "npm run build:css --workspace=@soxa-ui/theme-oren && npm run test:browser:webkit --workspace=@soxa-ui/playground-vue --",
    "test:parity": "npm run build:css --workspace=@soxa-ui/theme-oren && node tools/bench-pages/parity.mjs && node tools/bench-pages/parity-report.mjs",
    "compare:styles": "npm run compare:styles --workspace=@soxa-ui/playground-vue --",
    "check:public-api": "vitest run --root tools/public-api",
    "generate:api": "tsx --tsconfig packages/setup/tsconfig.json tools/api-docs/cli.ts",
    "check:api-docs": "npm run generate:api -- --check",
    "test:api-docs": "vitest run --root tools/api-docs",
    "typecheck:api-docs": "tsc --noEmit -p tools/api-docs/tsconfig.json",
    "check:api-package": "npm run generate:api -- --check-package",
    "release:plan": "node tools/release-plan/cli.mjs plan",
    "release:prepare": "node tools/release-plan/cli.mjs prepare",
    "test:release-plan": "vitest run --root tools/release-plan",
    "build:ai-docs": "node tools/ai-docs/cli.mjs",
    "test:ai-docs": "node --test tools/ai-docs/corpus.test.mjs",
    "check:ai-docs": "node tools/ai-docs/smoke.mjs"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "^8.1.1",
    "@changesets/assemble-release-plan": "^7.0.0",
    "@changesets/cli": "^3.0.3",
    "@changesets/config": "^4.0.1",
    "@changesets/pre": "^3.0.0",
    "@changesets/read": "^1.0.1",
    "@eslint/compat": "^2.1.1",
    "@manypkg/get-packages": "^3.1.0",
    "@npmcli/arborist": "^9.9.3",
    "@types/npmcli__arborist": "^6.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-vue": "~10.11.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "semver": "^7.8.5",
    "svelte-eslint-parser": "^1.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5"
  }
}
