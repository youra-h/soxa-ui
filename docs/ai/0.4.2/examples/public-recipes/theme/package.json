{
  "name": "@example/soxa-theme",
  "version": "1.0.0",
  "type": "module",
  "types": "./index.d.ts",
  "style": "./dist/index.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.css"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@soxa-ui/theme-base": "0.4.1"
  },
  "peerDependencies": {
    "@soxa-ui/core": "^0.4.2",
    "@soxa-ui/setup": "^0.4.2"
  }
}
